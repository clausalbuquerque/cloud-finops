# =============================================================================
# Cloud FinOps — ROOT .env.example  (SINGLE SOURCE OF TRUTH template)
# =============================================================================
# Copy to `.env`, fill in secrets, then run:  ./scripts/sync-env.sh
# to distribute copies to each sub-project.
#
# NOTE: a bare `PORT` is intentionally omitted — each NestJS service uses its
# code default (consumption=3000, metrics=3001). docker-compose sets its own
# env and does NOT read these .env files.
# -----------------------------------------------------------------------------

# --- Runtime ---
NODE_ENV=development

# --- Database (shared: extractors + database project) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres123
DB_DATABASE=cloud_finops
DB_SCHEMA=finops
DB_SYNCHRONIZE=false
DB_LOGGING=true

# SQLAlchemy URL for the Python AI runtime (ai-agents/python)
DATABASE_URL=postgresql+psycopg://postgres:postgres123@localhost:5432/cloud_finops

# --- Azure credentials (extractors) ---
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_SUBSCRIPTION_ID=your-subscription-id

# --- Dashboard (Vite) ---
VITE_API_BASE_URL=http://localhost:3000

# --- AI: Embeddings (nomic-embed-text-v1.5) ---
EMBEDDING_MODEL_NAME=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=15.0
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BACKOFF_SECONDS=0.5
EMBEDDING_LOCAL_FILES_ONLY=false
# HF token (first non-empty wins): HF_TOKEN, HUGGINGFACEHUB_API_TOKEN, HUGGINGFACE_API_TOKEN, hf_token
HF_TOKEN=

# --- AI: LLM (Gemini via Vertex AI) — see ai-agents/docs/adr-agent-runtime.md ---
# Dev/test: Vertex AI Express-mode API key. build_llm() reads GCP_AGENTS_API_KEY,
# sets GOOGLE_GENAI_USE_VERTEXAI=true and passes it as GOOGLE_API_KEY.
GCP_AGENTS_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=true
# Prod (ADC / service account): leave the key empty, set these instead, and run
# `gcloud auth application-default login`.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Model tiers (verify current IDs in the Vertex AI model catalog before pinning)
GEMINI_MODEL_PRO=gemini/gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini/gemini-2.5-flash
