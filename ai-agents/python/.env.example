EMBEDDING_MODEL_NAME=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=15.0
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BACKOFF_SECONDS=0.5
DATABASE_URL=
# Supported token envs (first non-empty wins): HF_TOKEN, HUGGINGFACEHUB_API_TOKEN,
# HUGGINGFACE_API_TOKEN, hf_token
HF_TOKEN=

# Set true to avoid remote calls and load only from local HF cache.
EMBEDDING_LOCAL_FILES_ONLY=false

# --- LLM (Gemini via Vertex AI) — see ai-agents/docs/adr-agent-runtime.md ---
# Dev/test: Vertex AI Express-mode API key (Google recommends API key for testing, ADC for prod).
# The build_llm() factory reads GCP_AGENTS_API_KEY (defined in the ROOT .env) and, for Express mode,
# exports GOOGLE_API_KEY + GOOGLE_GENAI_USE_VERTEXAI=true for the CrewAI google-genai client.
GCP_AGENTS_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=true
# Prod (ADC / service account): leave the key empty and set these instead, with `gcloud auth application-default login`.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Model tiers (verify current IDs in the Vertex AI model catalog before pinning).
GEMINI_MODEL_PRO=gemini/gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini/gemini-2.5-flash
